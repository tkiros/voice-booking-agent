# Copy to .env (make does this for you). Never commit .env.

# Host-side runs (make run / test / eval / demo). The app container overrides this with the service name.
DATABASE_URL=postgresql://app:app@localhost:5437/app

# Docker Compose project name: keeps this stack's containers and volume separate from other projects.
PROJECT_NAME=voice-booking

# Shared secret for the webhook. Vapi sends it as "Authorization: Bearer <VAPI_SECRET>" once you
# attach a Bearer Token credential to the tools (see vapi/README.md). Requests without it get 401.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_SECRET=change-me-before-exposing-a-tunnel

# Optional: send confirmation emails. Without SMTP_HOST, confirmations stay in the outbox table.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=bookings@example.com

# Scenario harness only: freezes the shop's clock (shop-local time). Leave unset for real calls.
# FAKE_NOW=2026-11-16T08:30
